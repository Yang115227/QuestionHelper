<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".QuestionApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.QuestionHelper"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.QuestionHelper">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".search.CameraSearchActivity" android:theme="@style/Theme.QuestionHelper" />
        <activity android:name=".search.SearchResultActivity" android:theme="@style/Theme.QuestionHelper" android:launchMode="singleTask" />
        
        <!-- 题库相关 Activity -->
        <activity android:name=".bank.QuestionBankActivity" android:theme="@style/Theme.QuestionHelper" />
        <activity android:name=".bank.PracticeActivity" android:theme="@style/Theme.QuestionHelper" />
        <activity android:name=".bank.ImportActivity" android:theme="@style/Theme.QuestionHelper" />
        <!-- 新增：练习选择页 -->
        <activity android:name=".bank.PracticeSelectActivity" android:theme="@style/Theme.QuestionHelper" />

        <!-- 录屏搜题服务 -->
        <service
            android:name=".search.ScreenCaptureService"
            android:foregroundServiceType="mediaProjection"
            android:exported="false" />

        <!-- 无障碍搜题服务 -->
        <service
            android:name=".search.AccessibilitySearchService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- 悬浮窗服务 -->
        <service
            android:name=".search.FloatWindowService"
            android:exported="false" />

    </application>
</manifest>